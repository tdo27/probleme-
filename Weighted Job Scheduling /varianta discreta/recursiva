#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
struct job {
	int s, f, pr;
};
bool regula(job a, job b) {
	return a.f < b.f;
}
int lastjob(int indice, vector<job>& v) {
	for (int j = indice - 1; j >= 0; --j)
		if (v[j].f <= v[indice - 1].s)// daca vrei sa cauti cel mai mare sir STRICT crescator trebuie eliminat acest egal
			return j;
	return -1;
}
int profitMx(int n, vector<job>& v) {
	if (n == 1)
		return v[n - 1].pr;
	int includePr = v[n - 1].pr;
	int last = lastjob(n, v);
	if (last != -1)
		includePr += profitMx(last + 1, v);
	int excludePr = profitMx(n - 1, v);
	return max(includePr, excludePr);
}
int main() {
	int n;
	cin >> n;
	vector<job>v(n);
	for (int i = 0; i < n; ++i)
		cin >> v[i].s >> v[i].f >> v[i].pr;
	sort(v.begin(), v.end(), regula);
	cout << profitMx(n, v);
	return 0;
}
