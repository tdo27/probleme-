#include <iostream>
using namespace std;
const int Max = 101;
int mat[Max][Max];
int s[Max][Max];
int n, m;
int main() {
	cin >> n >> m;
	for (int i = 1; i <= n; ++i)
		for (int j = 1; j <= m; ++j) {
			cin >> mat[i][j];
			if (i == 1 || j == 1)
				s[i][j] = mat[i][j];
		}
	for (int i = 1; i <= n; ++i)
		for (int j = 1; j <= m; ++j)
			if (mat[i][j])
				s[i][j] = min({ s[i - 1][j],s[i][j - 1],s[i - 1][j - 1] }) + 1;
	int mx = 0;
	cout << '\n';
	for (int i = 1; i <= n; ++i) {
		for (int j = 1; j <= m; ++j)
			cout << s[i][j] << ' ';
		cout << '\n';
	}
	for (int i = 1; i <= n; ++i)
		for (int j = 1; j <= m; ++j)
			mx = max(mx, s[i][j]);
	cout << mx << '\n';
	return 0; 
}
