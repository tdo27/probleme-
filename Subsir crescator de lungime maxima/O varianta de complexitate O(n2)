#include <iostream>
using namespace std;
int v[1001];
int lis[1001];
int main() {
	int n;
	cin >> n;
	for (int i = 1; i <= n; ++i)
		cin >> v[i];
	int lx = 0;
	for (int i = n; i > 0; --i) {
		int l = 0;
		for (int j = i + 1; j <= n; ++j)
			if (v[j] >= v[i] && lis[j] > l)
				l = lis[j];
		lis[i] = l + 1;
		if (lx < lis[i])
			lx = lis[i];
	}
	cout << n - lx;
	return 0;
}
