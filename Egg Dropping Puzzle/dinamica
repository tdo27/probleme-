#include <iostream>
using namespace std;
const int nMax = 101;// in nMax este valoarea maxima al lui k
int dp[nMax][nMax];
int eggDrop(int n, int k) {
	for (int i = 1; i <= n; ++i) {
		dp[i][0] = 0;
		dp[i][1] = 1;
	}
	for (int i = 1; i <= k; ++i)
		dp[1][i] = i;
	for(int i=2;i<=n;++i)
		for (int j = 2; j <= k; ++j) {
			dp[i][j] = nMax;
			for (int x = 1; x <= j; ++x) {
				int res = 1 + max(dp[i - 1][x - 1], dp[i][j - x]);
				dp[i][j] = min(dp[i][j], res);
			}
		}
	return dp[n][k];
}
int main() {
	int n, k;
	cin >> n >> k;
	cout << eggDrop(n, k);
	return 0;
}
