#include <iostream>
#include <string>
using namespace std;
const int Max = 1001;
int dp[Max][Max];

int lcs(string X, string Y, int n, int m) {// in matrice se vor gasi toate subsirurile comune
    for (int i = 0; i <= n; ++i) {
        for (int j = 0; j <= m; ++j) {
            if (i == 0 || j == 0)
                dp[i][j] = 0;
            else if (X[i - 1] == Y[j - 1])
                dp[i][j] = dp[i - 1][j - 1] + 1;
            else
                dp[i][j] = max(dp[i][j - 1], dp[i - 1][j]);
        }
    }
    return dp[n][m];
}

int main() {
    string s1, s2;
    cin >> s1 >> s2;
    int n = s1.size();
    int m = s2.size();
    cout << lcs(s1, s2, n, m) << '\n';
    for (int i = 1; i <= n; ++i) {
        for (int j = 1; j <= m; ++j)
            cout << dp[i][j] << ' ';
        cout << '\n';
    } 
    return 0; 
}
