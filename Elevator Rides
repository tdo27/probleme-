#include <iostream>
#include <vector>
#define int long long
using namespace std;
const int nMax = 20;
const int oo = nMax + 1;
pair<int, int>best[1 << nMax];// este dp-ul
int weight[nMax];
int32_t main() {
	int n, x;
	cin >> n >> x;
	for (int i = 0; i < n; ++i)
		cin >> weight[i];
	best[0] = { 1,0 };
	for (int s = 1; s < (1 << n); ++s) {// s este submultimea selectata
		best[s] = { n + 1,0 };
		for (int p = 0; p <= n; ++p) {
			if (s & (1 << p)) {
				auto option = best[s ^ (1 << p)];
				if (option.second + weight[p] <= x)
					option.second += weight[p];// adaug persoana p la calatoria existenta
				else {
					// nu a incaput in ultima calatorie, deci rezerv o noua calatorie pt el
					option.first++;
					option.second = weight[p];
				}
				best[s] = min(best[s], option);
			}
		}
	}
	cout << best[(1 << n) - 1].first;
	return 0;
}
